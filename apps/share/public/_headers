/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
# public/ is copied verbatim — Vite does NOT hash these names, so the content
# hash is in the filename by hand (fraunces-latin.48282a41.woff2). That is what
# makes `immutable` honest: re-subsetting the font produces a new name instead of
# leaving a year of returning visitors stuck on a file they cannot bust.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/index.html
  Cache-Control: no-cache
# theme-boot.js 跟 index.html 同一类：public/ 不哈希文件名，而这个文件是首屏
# 主题的正确性依赖（改错了就是每次打开闪一下）。让它跟 index.html 一起
# revalidate，不要落进默认的启发式缓存里。
/theme-boot.js
  Cache-Control: no-cache